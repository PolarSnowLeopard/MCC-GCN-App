# Public ports exposed by the top-level Nginx reverse proxy.
# Defaults are the standard 80 / 443 because the host's own Nginx
# is no longer used. Override only if those ports are taken on the host.
APP_HTTP_PORT=80
APP_HTTPS_PORT=443

# Django
DEBUG=False
SECRET_KEY=change-me-to-a-random-string
ALLOWED_HOSTS=*

# Database
DB_NAME=mcc_gcn
DB_USER=postgres
DB_PASSWORD=change-me

# CORS / CSRF — fill in the actual public origin(s), comma-separated.
# Example: https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://example.com
